# Groq API key (the code reads it from both variables)
OPENAI_API_KEY=your_groq_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Azure Cosmos DB (only needed for scraping storage and KB building)
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your_cosmos_key
COSMOS_PRIMARY_KEY=your_cosmos_key
COSMOS_DATABASE=client
COSMOS_DATABASE_NAME=client
COSMOS_CONTAINER=scraping-results
COSMOS_CONTAINER_NAME=scraping-results
